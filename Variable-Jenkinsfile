pipeline {
    //Selection of agent for stage execution
    agent any
    //Defining Parameters
    parameters{
        string(name:'DEPLOY_ENV', defaultValue: 'dev', description: 'environment to deploy')
        booleanParam(name: 'RUN_TESTS',defaultValue: 'true',description: 'Run Tests ?')
    }
    //Defining custom environment variables
    environment{
        REGION = 'ap-south-1'
        BUILD_VERSION = "1.0.${env.BUILD_NUMBER}"
    }
    //Pipeline stages
    stages {
        //exploring built in variables
        stage('Built-in') {
            steps {
                echo "Built Numbers: ${env.BUILD_NUMBER}"
                echo "Built ID: ${env.BUILD_ID}"
                echo "JOB Name: ${env.JOB_NAME}"
                echo "Build URL: ${env.BUILD_URL}"
                echo "Workspace: ${env.WORKSPACE}"
                echo "Node NAME: ${env.NODE_NAME}"
            }
        }
        stage('PipeLine Parameters') {
            steps {
                //calling parameters which is creates in parameters
                echo "Deploy Env: ${params.DEPLOY_ENV}"
                echo "RUN TESTS: ${params.RUN_TESTS}"
            }
        }
        stage('Custom Variables') {
            steps {
                //custom environment variables
                echo "REGION : ${env.REGION}"
                echo  "BUILD_VERSION: ${env.BUILD_VERSION}"
            }
        }
        //dynamic custom variables
        stage('Dynamic Custom Variables') {
            steps {
                script{
                env.RUNTIME_VAR = "runtime-${env.BUILD_NUMBER}"
                echo  "DYNAMIC: ${env.RUNTIME_VAR}"                    
                }
            }
        }  
        //execution of shell script commands
        stage('ls') {
            steps {
                sh 'ls /var/lib/jenkins'
            }
        }
    }
}
